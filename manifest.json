{
  "manifest_version": 3,
  "name": "학생부 올인원 도우미 (Claude·GPT 구독 연동 사이드바)",
  "version": "1.1.0",
  "description": "웹사이트 및 나이스(NEIS) 화면 옆에서 Claude Pro·ChatGPT Plus 구독 세션을 바로 연결해 초안을 생성하는 사이드바",
  "permissions": [
    "sidePanel",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "https://*.vercel.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "학생부 도우미 사이드바 열기"
  }
}
